MODE=demo
DEVICE=auto
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173

MAX_UPLOAD_SIZE_MB=50
QUERY_CONFIDENCE_THRESHOLD=0.6

# Real Mode model paths — leave empty for demo mode
RS_VQA_MODEL_PATH=
GROUNDING_MODEL_PATH=
CHANGE_VQA_MODEL_PATH=
FUSION_MODEL_PATH=

# Encoder sources (HuggingFace Hub IDs)
# RS-adapted: chendelong/RemoteCLIP (ViT-B/32) — research use license
# Generic fallback: openai/clip-vit-base-patch32
REMOTE_CLIP_HF_ID=chendelong/RemoteCLIP
CLIP_FALLBACK_HF_ID=openai/clip-vit-base-patch32

# BigEarthNet.txt dataset (training/eval only — not required for demo mode)
# Download: huggingface-cli download BIFOLD-BigEarthNetv2-0/BigEarthNet.txt
# License: CDLA-Permissive 1.0
BEN_TXT_DATASET_PATH=
BEN_TXT_SPLIT=benchmark
